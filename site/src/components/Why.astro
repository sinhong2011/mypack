---
import { m } from "../paraglide/messages.js";
---
<section class="section" aria-labelledby="why-title" style="padding-top: 0">
  <div class="wrap">
    <div class="section-head">
      <h2 id="why-title" class="h2">{m.why_title()}</h2>
      <p class="lede">{m.why_lede()}</p>
    </div>
    <div class="why__grid">
      <div class="why__item"><h3 class="h3">{m.why1_t()}</h3><p>{m.why1_d()}</p></div>
      <div class="why__item"><h3 class="h3">{m.why2_t()}</h3><p>{m.why2_d()}</p></div>
      <div class="why__item"><h3 class="h3">{m.why3_t()}</h3><p>{m.why3_d()}</p></div>
    </div>
  </div>
</section>

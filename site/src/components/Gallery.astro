---
// A look around the app: tabs switch between real captures.
import { m } from "../paraglide/messages.js";
import Shot from "./Shot.astro";

const VIEWS = [
  { id: "library", tab: m.g_library_t(), cap: m.g_library_d() },
  { id: "discover", tab: m.g_discover_t(), cap: m.g_discover_d() },
  { id: "builds", tab: m.g_builds_t(), cap: m.g_builds_d() },
  { id: "palette", tab: m.g_palette_t(), cap: m.g_palette_d() },
  { id: "menubar", tab: m.g_menubar_t(), cap: m.g_menubar_d() },
] as const;
---
<section class="stage section" data-shader="stage" aria-labelledby="look-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="look-title" class="h2">{m.gallery_title()}</h2>
      <p class="lede">{m.gallery_lede()}</p>
    </div>
    <div class="tabs" role="tablist" aria-label={m.gallery_title()} data-tabs>
      {VIEWS.map((v, i) => (
        <button role="tab" id={`tab-${v.id}`} aria-controls={`view-${v.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>{v.tab}</button>
      ))}
    </div>
    <div class="viewer">
      {VIEWS.map((v, i) => (
        <figure role="tabpanel" id={`view-${v.id}`} aria-labelledby={`tab-${v.id}`} hidden={i !== 0}>
          <Shot name={v.id} alt={v.cap} class={v.id === "menubar" ? "narrow" : ""} />
          <figcaption>{v.cap}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
